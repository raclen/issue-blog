---
import FuwariBlogLayout from "@/layouts/FuwariBlogLayout.astro";
import FuwariBentoCard from "@/components/fuwari/FuwariBentoCard.astro";
import { getPosts } from "@/lib/posts";
import config from "@/config";

const posts = await getPosts();

const tagCounts = new Map<string, number>();
const yearCounts = new Map<string, number>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }

  const year = post.data.pubDate.getFullYear().toString();
  yearCounts.set(year, (yearCounts.get(year) ?? 0) + 1);
}

const tags = Array.from(tagCounts, ([tag, count]) => ({ tag, count })).sort(
  (a, b) => b.count - a.count || a.tag.localeCompare(b.tag, "zh-CN")
);
const years = Array.from(yearCounts, ([year, count]) => ({ year, count })).sort(
  (a, b) => Number(b.year) - Number(a.year)
);
---

<FuwariBlogLayout
  title={config.site.title}
  description={config.site.description}
  postsCount={posts.length}
  years={years}
  tags={tags}
  showBanner={true}
  bannerTitle={config.site.title}
  bannerSubtitle={config.site.description}
>
  <div class="space-y-4">
    {posts.map(post => <FuwariBentoCard post={post} />)}
  </div>
</FuwariBlogLayout>
