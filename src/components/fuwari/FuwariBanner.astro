---
import config from "@/config";

interface Props {
  title?: string;
  subtitle?: string;
  bannerImage?: string;
  heightClass?: string;
}

const {
  title = config.site.title,
  subtitle = config.site.description,
  bannerImage = "https://images.unsplash.com/photo-1579546929518-9e396f3cc809?q=80&w=2070&auto=format&fit=crop",
  heightClass = "h-72 sm:h-80 md:h-96",
} = Astro.props;
---

<div class={`relative w-full overflow-hidden ${heightClass} select-none`}>
  <!-- Banner Background Image -->
  <img
    src={bannerImage}
    alt="Site Banner"
    class="absolute inset-0 w-full h-full object-cover object-center transform scale-105 filter blur-[0.5px] brightness-[0.85] dark:brightness-[0.7] transition-all duration-700"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Gradient Overlay (Fade smoothly into background) -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/30 to-background/95 transition-colors duration-300"
  >
  </div>

  <!-- Banner Content -->
  <div
    class="relative z-10 max-w-6xl mx-auto h-full px-4 sm:px-6 md:px-8 flex flex-col justify-end pb-10 sm:pb-12 text-white"
  >
    <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-medium tracking-wide uppercase text-white/90 border border-white/20 w-fit">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      Raclen's Blog
    </div>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight drop-shadow-md text-white">
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-2 text-sm sm:text-base md:text-lg text-white/80 max-w-2xl font-normal drop-shadow">
          {subtitle}
        </p>
      )
    }
  </div>
</div>
