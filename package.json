{
  "name": "issue-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Cloudflare-deployable Astro blog that syncs posts from GitHub Issues.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "sync:issues": "node scripts/sync-issues.js",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@pagefind/default-ui": "^1.5.2",
    "@tailwindcss/vite": "4.3.1",
    "astro": "^6.4.8",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "slugify": "^1.6.9",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "astro-pagefind": "^2.0.1",
    "pagefind": "^1.5.2",
    "vite": "^7.3.6",
    "wrangler": "^4.105.0"
  }
}
